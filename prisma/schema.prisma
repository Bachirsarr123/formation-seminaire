generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SOCLE
// ============================================================

model Cabinet {
  id               String   @id @default(uuid())
  nom              String
  logoUrl          String?  @map("logo_url")
  couleurPrimaire  String?  @map("couleur_primaire")
  // Contact public volontairement distinct des comptes Utilisateur : retomber
  // sur l'e-mail d'un organisateur exposerait une adresse jamais choisie pour
  // être publique (ex. affichage "séminaire complet").
  emailContact     String?  @map("email_contact")
  telephoneContact String?  @map("telephone_contact")
  // Affichée en pied de page du formulaire de recueil et de sa consultation
  // (lot recueil) — absente ailleurs pour l'instant.
  adresse          String?  @map("adresse")
  // Secret d'URL du flux d'abonnement agenda (.ics) — distinct de tout jeton
  // participant, régénérable indépendamment (bouton de révocation visible,
  // lib/organisateur/agenda.ts). Nullable : généré à la première demande de
  // flux, pas à la création du cabinet.
  jetonFluxIcs     String?  @unique @map("jeton_flux_ics")
  createdAt        DateTime @default(now()) @map("created_at")

  utilisateurs   Utilisateur[]
  seminaires     Seminaire[]
  participants   Participant[]
  questionnaires Questionnaire[]
  recueils       Recueil[]

  @@map("cabinet")
}

enum RoleUtilisateur {
  ORGANISATEUR
  FORMATEUR

  @@map("role_utilisateur")
}

model Utilisateur {
  id             String          @id @default(uuid())
  cabinetId      String          @map("cabinet_id")
  email          String          @unique
  nom            String
  prenom         String
  role           RoleUtilisateur
  // nullable : les formateurs n'ont pas de mot de passe, ils passent par lien magique
  motDePasseHash String?         @map("mot_de_passe_hash")
  actif          Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")

  cabinet             Cabinet                  @relation(fields: [cabinetId], references: [id])
  seminaireFormateurs SeminaireFormateur[]
  sessions            SessionOrganisateur[]
  jetonsAction        JetonActionUtilisateur[]
  // Inscriptions dont ce compte a régénéré le jeton participant — traçabilité
  // de l'action (lib/organisateur/participants.ts), jamais l'inverse (un
  // Utilisateur ne référence aucun participant/inscription qu'il gère au
  // quotidien, seulement celles dont IL a personnellement déclenché la
  // régénération).
  jetonsRegeneres     Inscription[]            @relation("JetonRegenerePar")
  importsEnAttente    ImportEnAttente[]
  // Notations données EN TANT QUE formateur (lot notation) — un compte
  // ORGANISATEUR n'apparaît jamais ici, voir Notation.formateur.
  notationsDonnees    Notation[]               @relation("NotationDonneePar")

  @@index([cabinetId])
  @@map("utilisateur")
}

// ============================================================
// AUTHENTIFICATION ORGANISATEUR/FORMATEUR
// ============================================================

// Session par cookie httpOnly, 12h glissantes (expiresAt prolongé à chaque
// résolution réussie). Le cookie ne porte qu'un jeton opaque : seul son hash
// est stocké ici, jamais le jeton en clair — une fuite de la table ne rend
// aucune session utilisable. Cascade sur Utilisateur : un compte désactivé/
// supprimé ferme immédiatement toutes ses sessions ouvertes.
model SessionOrganisateur {
  id            String   @id @default(uuid())
  utilisateurId String   @map("utilisateur_id")
  tokenHash     String   @unique @map("token_hash")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("session_organisateur")
}

enum TypeJetonAction {
  REINITIALISATION_MOT_DE_PASSE
  CONNEXION_FORMATEUR

  @@map("type_jeton_action")
}

// Table unique pour les deux jetons à usage unique de ce lot (réinitialisation
// de mot de passe, lien magique formateur) : mêmes invariants (une seule
// utilisation, expiration courte, traçable) — un type au lieu de deux tables
// qui finiraient par diverger. `tokenHash` pour la même raison que la session
// ci-dessus. `utiliseLe` posé une fois, jamais réutilisable après.
model JetonActionUtilisateur {
  id            String          @id @default(uuid())
  utilisateurId String          @map("utilisateur_id")
  type          TypeJetonAction
  tokenHash     String          @unique @map("token_hash")
  expiresAt     DateTime        @map("expires_at")
  utiliseLe     DateTime?       @map("utilise_le")
  createdAt     DateTime        @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, type])
  @@map("jeton_action_utilisateur")
}

// Verrouillage de connexion scopé au couple (email, IP) — jamais sur la ligne
// Utilisateur elle-même : un verrou par email seul est un déni de service
// trivial (un tiers qui connaît l'adresse d'un organisateur le bloque en
// échouant volontairement, depuis n'importe où). Ici, un attaquant échouant
// depuis SON IP ne bloque que le couple (email, cette IP) — jamais l'accès du
// titulaire légitime depuis sa propre IP habituelle.
//
// `emailNormalise` : ce que verifierIdentifiants() reçoit après
// normaliserEmail() (lib/normalisation.ts), pas l'email brut saisi.
//
// Durée de vie courte par construction : une ligne sans échec depuis plus de
// la fenêtre de verrouillage est traitée comme réinitialisée par la logique
// applicative (pas de purge en base nécessaire à cette échelle).
model TentativeConnexionOrganisateur {
  id             String    @id @default(uuid())
  emailNormalise String    @map("email_normalise")
  ip             String
  tentatives     Int       @default(0)
  dernierEchecLe DateTime? @map("dernier_echec_le")
  bloqueJusqua   DateTime? @map("bloque_jusqua")

  @@unique([emailNormalise, ip])
  @@map("tentative_connexion_organisateur")
}

// ============================================================
// SEMINAIRES
// ============================================================

enum Modalite {
  PRESENTIEL
  DISTANCIEL
  HYBRIDE

  @@map("modalite")
}

enum StatutSeminaire {
  BROUILLON
  PUBLIE
  EN_COURS
  CLOTURE
  ARCHIVE

  @@map("statut_seminaire")
}

model Seminaire {
  id                 String          @id @default(uuid())
  cabinetId          String          @map("cabinet_id")
  // nanoid(10), généré côté application, jamais deviné
  codePublic         String          @unique @map("code_public")
  titre              String
  description        String?
  dateDebut          DateTime        @map("date_debut")
  dateFin            DateTime        @map("date_fin")
  lieu               String?
  modalite           Modalite
  dureeHeures        Float           @map("duree_heures")
  capaciteMax        Int?            @map("capacite_max")
  statut             StatutSeminaire @default(BROUILLON)
  inscriptionOuverte Boolean         @default(false) @map("inscription_ouverte")
  validationRequise  Boolean         @default(false) @map("validation_requise")
  // en dessous de ce nombre de messages anonymes, l'organisateur ne voit rien
  seuilAnonymat      Int             @default(5) @map("seuil_anonymat")
  createdAt          DateTime        @default(now()) @map("created_at")
  // Suppression logique. Les enfants (modules, inscriptions, questionnaires,
  // messages) ne sont jamais supprimés en cascade : ils restent auditables.
  // Toute requête applicative doit filtrer `supprimeLe: null` par défaut.
  supprimeLe         DateTime?       @map("supprime_le")

  cabinet          Cabinet              @relation(fields: [cabinetId], references: [id])
  modules          Module[]
  formateurs       SeminaireFormateur[]
  inscriptions     Inscription[]
  questionnaires   Questionnaire[]
  messagesAnonymes MessageAnonyme[]
  importsEnAttente ImportEnAttente[]
  // Lot recueil (formulaire de recueil des besoins pré-formation) : table
  // entièrement séparée du questionnaire d'évaluation, voir plus bas.
  recueil          Recueil?
  supportsCours    SupportCours[]

  @@index([cabinetId])
  @@map("seminaire")
}

model Module {
  id           String  @id @default(uuid())
  seminaireId  String  @map("seminaire_id")
  titre        String
  description  String?
  dureeMinutes Int     @map("duree_minutes")
  ordre        Int

  // Restrict : Seminaire est en suppression logique, on ne veut plus jamais
  // qu'un DELETE physique dessus emporte silencieusement ses modules.
  seminaire Seminaire  @relation(fields: [seminaireId], references: [id], onDelete: Restrict)
  questions Question[]

  @@index([seminaireId])
  @@map("module")
}

// Même structure que Module (pas de cabinetId propre — l'isolation par
// cabinet passe par seminaire.cabinetId, comme partout dans
// lib/organisateur/) : un support de cours appartient à un séminaire, pas
// directement à un cabinet.
//
// `urlStockage` : pour l'adaptateur de stockage local (le seul implémenté
// pour ce lot, voir lib/organisateur/stockage-supports.ts), c'est le chemin
// relatif du fichier sur le disque du conteneur — PAS une URL publique. Si
// un adaptateur S3 est branché plus tard, ce même champ portera l'URL/la clé
// de l'objet distant ; la forme change selon l'adaptateur, jamais le nom du
// champ ni son rôle (localiser le fichier physique).
model SupportCours {
  id                  String    @id @default(uuid())
  seminaireId         String    @map("seminaire_id")
  titre               String
  nomFichier          String    @map("nom_fichier")
  // en octets — voir PLAFOND_TAILLE_SUPPORT_OCTETS (10 Mo).
  tailleFichier       Int       @map("taille_fichier")
  typeMime            String    @map("type_mime")
  urlStockage         String    @map("url_stockage")
  visibleParticipants Boolean   @default(true) @map("visible_participants")
  ordre               Int
  createdAt           DateTime  @default(now()) @map("created_at")
  // Suppression logique, jamais physique (contrainte du lot) — le fichier
  // sur disque n'est pas non plus effacé : filet de sécurité en cas de
  // suppression accidentelle, coût négligeable à l'échelle de ce lot.
  supprimeLe          DateTime? @map("supprime_le")

  seminaire Seminaire @relation(fields: [seminaireId], references: [id], onDelete: Restrict)

  @@index([seminaireId])
  @@map("support_cours")
}

enum RoleFormateur {
  PRINCIPAL
  INTERVENANT

  @@map("role_formateur")
}

model SeminaireFormateur {
  seminaireId   String        @map("seminaire_id")
  utilisateurId String        @map("utilisateur_id")
  roleFormateur RoleFormateur @map("role_formateur")

  seminaire   Seminaire   @relation(fields: [seminaireId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([seminaireId, utilisateurId])
  @@map("seminaire_formateur")
}

// ============================================================
// PARTICIPANTS
// ============================================================

// Rattaché au cabinet, pas au séminaire : historique conservé entre sessions.
//
// email et telephone sont tous deux nullables : beaucoup de participants ne
// sont joignables que par WhatsApp. Une contrainte CHECK en base garantit
// qu'au moins l'un des deux est renseigné (email IS NOT NULL OR telephone
// IS NOT NULL) — Prisma n'a pas de syntaxe déclarative pour les contraintes
// CHECK, elle doit donc être ajoutée à la main dans le SQL de la première
// migration :
//   ALTER TABLE "participant"
//     ADD CONSTRAINT "participant_contact_requis"
//     CHECK (email IS NOT NULL OR telephone IS NOT NULL);
//
// Deux index uniques partiels (migration 20260730131832, même limite du DSL
// Prisma) empêchent en base deux participants avec le même email/téléphone
// normalisé dans un même cabinet — filet de sécurité contre la double
// création en cas d'inscriptions concurrentes de la même personne. Voir
// lib/participant.ts pour le rattrapage applicatif de cette violation.
model Participant {
  id           String   @id @default(uuid())
  cabinetId    String   @map("cabinet_id")
  nom          String
  prenom       String
  email        String?
  telephone    String?
  fonction     String?
  organisation String?
  createdAt    DateTime @default(now()) @map("created_at")

  cabinet       Cabinet        @relation(fields: [cabinetId], references: [id])
  inscriptions  Inscription[]
  consentements Consentement[]

  @@index([cabinetId])
  @@map("participant")
}

enum StatutInscription {
  EN_ATTENTE
  CONFIRMEE
  REFUSEE
  ANNULEE

  @@map("statut_inscription")
}

enum SourceInscription {
  IMPORT
  MANUEL
  AUTO_INSCRIPTION

  @@map("source_inscription")
}

model Inscription {
  id                 String            @id @default(uuid())
  seminaireId        String            @map("seminaire_id")
  participantId      String            @map("participant_id")
  // nanoid(21), généré côté application — c'est le jeton de la Règle 1
  jeton              String            @unique
  statut             StatutInscription @default(EN_ATTENTE)
  source             SourceInscription
  dateInscription    DateTime          @default(now()) @map("date_inscription")
  jetonExpireLe      DateTime?         @map("jeton_expire_le")
  aRepondu           Boolean           @default(false) @map("a_repondu")
  // Volontairement une DATE sans heure : voir note sur `soumission` plus bas.
  aReponduLe         DateTime?         @map("a_repondu_le") @db.Date
  // Trace la régénération du jeton (action explicite de l'espace organisateur,
  // lib/organisateur/participants.ts) : qui, quand. SetNull si le compte est
  // ensuite supprimé — l'historique de régénération n'a pas besoin de bloquer
  // la suppression d'un Utilisateur.
  jetonRegenereLe    DateTime?         @map("jeton_regenere_le")
  jetonRegenereParId String?           @map("jeton_regenere_par_id")

  // Restrict, pas Cascade : une suppression de Participant (RGPD) ne doit
  // jamais silencieusement emporter ses inscriptions. L'app doit d'abord
  // supprimer/anonymiser les inscriptions explicitement, puis le participant
  // — sans risque pour les données d'évaluation, qui n'y sont pas rattachées.
  seminaire        Seminaire      @relation(fields: [seminaireId], references: [id], onDelete: Restrict)
  participant      Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  jetonRegenerePar Utilisateur?   @relation("JetonRegenerePar", fields: [jetonRegenereParId], references: [id], onDelete: SetNull)
  consentements    Consentement[]
  // Lot notation (formateur) : jamais lu depuis l'espace participant, voir
  // Notation ci-dessous — cette relation existe pour l'espace organisateur
  // uniquement.
  notation         Notation?
  // (Inscription elle-même est une ligne "légère" : la supprimer pour un
  // participant donné ne touche à aucune donnée d'évaluation, cf. plus haut.)

  // Une ligne par couple (séminaire, participant), y compris à travers les
  // annulations : une ré-inscription après ANNULEE réutilise cette même ligne
  // (statut -> CONFIRMEE, jeton régénéré) plutôt que d'en insérer une nouvelle.
  // Ne pas contourner cette contrainte par un INSERT côté application.
  @@unique([seminaireId, participantId])
  @@index([seminaireId])
  @@index([participantId])
  @@map("inscription")
}

// ============================================================
// NOTATION FORMATEUR
//
// À l'opposé de Soumission/Reponse (Règle 2, zone cloisonnée) : la notation
// EST rattachée à l'identité (Inscription), c'est son but — le formateur
// note UNE personne, pas une réponse anonyme. Jamais lue depuis l'espace
// participant (vérifié par tests/schema/notation-confidentialite.test.ts,
// qui grep le code participant à la recherche de toute référence).
// ============================================================

enum TypeNotation {
  PRESENCE
  PARTICIPATION
  TEST
  APPRECIATION

  @@map("type_notation")
}

// Une seule notation par inscription (contrainte @unique) : le formateur
// choisit UN type par personne, pas un score par dimension — noter à
// nouveau la même inscription REMPLACE la notation existante (upsert),
// jamais un ajout. `justification` est NOT NULL au niveau Prisma, mais une
// chaîne vide passerait cette contrainte : une contrainte CHECK
// (non exprimable dans le DSL Prisma, ajoutée à la main dans le SQL de
// migration comme participant_contact_requis) interdit aussi une
// justification blanche. Une deuxième contrainte CHECK garantit la
// cohérence valeur/barème/type : APPRECIATION n'a ni valeur ni barème, tout
// autre type a les deux, et la valeur reste dans les bornes du barème.
model Notation {
  id            String       @id @default(uuid())
  inscriptionId String       @unique @map("inscription_id")
  formateurId   String       @map("formateur_id")
  typeNotation  TypeNotation @map("type_notation")
  // null uniquement pour APPRECIATION — voir contrainte CHECK
  // notation_valeur_coherente (migration).
  valeur        Float?
  // ex. 20 pour une note sur 20 ; toujours renseigné avec `valeur`, jamais
  // seul.
  bareme        Float?
  justification String
  createdAt     DateTime     @default(now()) @map("created_at")

  // Restrict (jamais Cascade) sur les deux relations : une notation est une
  // pièce d'audit ("pourquoi ce collaborateur a eu 11"), elle ne doit jamais
  // disparaître silencieusement à cause d'une suppression ailleurs — ni
  // Inscription ni Utilisateur ne sont d'ailleurs jamais supprimés
  // physiquement dans cette application (suppression logique/désactivation
  // uniquement).
  inscription Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Restrict)
  formateur   Utilisateur @relation("NotationDonneePar", fields: [formateurId], references: [id], onDelete: Restrict)

  @@index([formateurId])
  @@map("notation")
}

// Aperçu validé d'un import CSV en masse (lot 4, étape 7), en attente de
// confirmation par l'organisateur qui l'a téléversé. `donnees` (Json) ne
// porte QUE les lignes déjà validées par previsualiserImportCsv — jamais le
// fichier brut, qui n'est ni stocké sur disque ni conservé une fois
// l'aperçu produit. Existe pour éviter de faire transiter des données
// personnelles complètes (noms, emails, téléphones) via un champ caché du
// formulaire de confirmation : ce HTML est mis en cache par le navigateur
// et peut apparaître dans une capture d'écran.
//
// Usage unique PAR SUCCÈS, pas par tentative : confirmerImportCsv ne
// supprime cette ligne qu'une fois l'écriture réellement effectuée (même
// transaction verrouillée) — un échec par capacité insuffisante la laisse
// intacte pour une nouvelle tentative sans réimporter le fichier.
//
// Pas de purge active des lignes expirées : même raisonnement que
// TentativeConnexionOrganisateur ci-dessus — une ligne expirée est traitée
// comme absente par la logique applicative, inutile à purger à cette
// échelle. onDelete Cascade sur les deux relations : donnée jetable, sans
// l'obligation d'audit qui justifie le Restrict d'Inscription.
model ImportEnAttente {
  id            String   @id @default(uuid())
  seminaireId   String   @map("seminaire_id")
  utilisateurId String   @map("utilisateur_id")
  donnees       Json
  expireLe      DateTime @map("expire_le")
  createdAt     DateTime @default(now()) @map("created_at")

  seminaire   Seminaire   @relation(fields: [seminaireId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([seminaireId])
  @@map("import_en_attente")
}

// ============================================================
// CONSENTEMENT — table en ajout seul
//
// Aucune ligne n'est jamais modifiée après création, sauf pour y poser
// `retireLe` une unique fois (et jamais pour INSCRIPTION_EVALUATION, qui
// n'est pas un consentement retirable mais la preuve d'une information
// donnée). Deux triggers en base (migration manuelle, hors DSL Prisma)
// interdisent tout UPDATE hors `retireLe` et tout DELETE, quel que soit le
// code applicatif appelant — voir prisma/migrations/*_ajout_consentement.
//
// Portée de l'unicité "une ligne active par...", différente selon la
// finalité (index partiels, migration manuelle) :
//   - INSCRIPTION_EVALUATION, COMMUNICATIONS : globale au participant
//     (participant_id, finalite) WHERE retire_le IS NULL.
//   - PARTAGE_EMPLOYEUR : par formation, puisque consentir au partage avec
//     l'employeur A ne vaut pas consentement pour l'employeur B
//     (participant_id, inscription_id, finalite) WHERE retire_le IS NULL.
//     Une contrainte CHECK garantit que inscription_id n'est jamais nul pour
//     cette finalité (sans quoi l'index partiel ci-dessus perdrait son sens :
//     deux NULL ne se heurtent jamais dans un index Postgres).
// ============================================================

enum FinaliteConsentement {
  // Pas une case à cocher : exécution du service demandé, simple mention
  // d'information. Preuve de la version du texte affichée, non retirable
  // (trigger dédié).
  INSCRIPTION_EVALUATION
  // Facultatif, non pré-coché : informations sur les prochaines formations.
  COMMUNICATIONS
  // Facultatif, non pré-coché : transmission présence/attestation à
  // l'employeur qui finance — scopé par inscription, pas par participant.
  PARTAGE_EMPLOYEUR

  @@map("finalite_consentement")
}

model Consentement {
  id            String               @id @default(uuid())
  participantId String               @map("participant_id")
  inscriptionId String?              @map("inscription_id")
  finalite      FinaliteConsentement
  versionTexte  String               @map("version_texte")
  donneLe       DateTime             @map("donne_le")
  retireLe      DateTime?            @map("retire_le")
  // hash de l'IP + user-agent (HMAC, secret dédié) — jamais l'IP en clair
  preuveHash    String               @map("preuve_hash")

  participant Participant  @relation(fields: [participantId], references: [id], onDelete: Restrict)
  inscription Inscription? @relation(fields: [inscriptionId], references: [id], onDelete: Restrict)

  @@index([participantId, finalite])
  @@index([inscriptionId])
  @@map("consentement")
}

// ============================================================
// QUESTIONNAIRE
// ============================================================

enum StatutQuestionnaire {
  BROUILLON
  PUBLIE
  FERME

  @@map("statut_questionnaire")
}

// Un modèle est un questionnaire comme les autres, simplement détaché d'un
// séminaire (seminaireId nul) — pas de tables ModeleQuestionnaire/Section/
// Question en miroir : un seul jeu de tables, un seul éditeur, un seul rendu.
// Créer le questionnaire d'un séminaire = copie profonde d'un modèle
// (lib/questionnaire/copier-modele.ts), modeleOrigineId tracé.
//
// Contrainte CHECK (migration manuelle, non exprimable dans le DSL Prisma) :
//   (est_modele = true AND seminaire_id IS NULL)
//   OR (est_modele = false AND seminaire_id IS NOT NULL)
//
// verrouilleLe est posé automatiquement au passage en PUBLIE (trigger,
// migration manuelle) et n'est plus jamais modifiable une fois posé. Mais
// verrouilleLe seul ne bloque rien : ce qui rend section/question immuables,
// c'est verrouilleLe non nul ET au moins une soumission déjà reçue (trigger
// sur section/question) — voir lib/questionnaire/verrouillage.ts pour la
// même règle côté applicatif.
model Questionnaire {
  id              String              @id @default(uuid())
  cabinetId       String              @map("cabinet_id")
  seminaireId     String?             @map("seminaire_id")
  estModele       Boolean             @default(false) @map("est_modele")
  // nom du modèle dans la bibliothèque du cabinet — nul pour un questionnaire
  // de séminaire, qui garde `titre` comme seul nom affiché aux participants.
  nom             String?
  modeleOrigineId String?             @map("modele_origine_id")
  titre           String
  dateLimite      DateTime?           @map("date_limite")
  statut          StatutQuestionnaire @default(BROUILLON)
  verrouilleLe    DateTime?           @map("verrouille_le")
  // Suppression logique, même logique que Seminaire : les Soumissions/Reponses
  // qui en dépendent (via Section/Question) restent auditables indéfiniment.
  supprimeLe      DateTime?           @map("supprime_le")
  // Absente jusqu'au lot 5 (étape 13) : nécessaire pour déterminer le
  // questionnaire ACTIF d'un séminaire quand il en porte plusieurs au fil du
  // temps (dupliquerQuestionnaire après verrouillage en crée un nouveau,
  // rattaché au même séminaire) — id est un uuid v4, jamais ordonnable dans
  // le temps.
  createdAt       DateTime            @default(now()) @map("created_at")

  cabinet        Cabinet         @relation(fields: [cabinetId], references: [id])
  seminaire      Seminaire?      @relation(fields: [seminaireId], references: [id], onDelete: Restrict)
  modeleOrigine  Questionnaire?  @relation("CopieModele", fields: [modeleOrigineId], references: [id], onDelete: Restrict)
  copiesDuModele Questionnaire[] @relation("CopieModele")
  sections       Section[]
  soumissions    Soumission[]

  @@index([seminaireId])
  @@index([cabinetId])
  @@map("questionnaire")
}

model Section {
  id              String  @id @default(uuid())
  questionnaireId String  @map("questionnaire_id")
  titre           String
  description     String?
  ordre           Int

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  questions     Question[]

  @@index([questionnaireId])
  @@map("section")
}

enum TypeQuestion {
  NOTE_5
  NOTE_10
  ECHELLE_4
  QCM_UNIQUE
  QCM_MULTIPLE
  TEXTE_LIBRE
  OUI_NON
  NPS

  @@map("type_question")
}

model Question {
  id                  String       @id @default(uuid())
  sectionId           String       @map("section_id")
  moduleId            String?      @map("module_id")
  intitule            String
  description         String?
  type                TypeQuestion
  obligatoire         Boolean      @default(false)
  ordre               Int
  // pour les QCM : options.choix = [{ id, libelle }]
  // pour ECHELLE_4 (obligatoire pour ce type, un Likert sans intitulé ne veut
  // rien dire) : options.libelles = { "1": "...", "2": "...", "3": "...", "4": "..." }
  options             Json?
  // Case « Sans opinion » distincte de « pas répondu » : voir Reponse plus
  // bas (valeurOptions.sansOpinion), qui garde une ligne mais valeurNumerique
  // null — sans ça, une moyenne agrégerait silencieusement des choix au
  // hasard de participants sans avis réel.
  autoriseSansOpinion Boolean      @default(false) @map("autorise_sans_opinion")
  // Suppression logique : une Question ayant déjà des Reponses ne doit
  // jamais disparaître physiquement (elle en perdrait le sens pour l'audit).
  supprimeLe          DateTime?    @map("supprime_le")

  section  Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  module   Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  reponses Reponse[]

  @@index([sectionId])
  @@index([moduleId])
  @@map("question")
}

// ============================================================
// RÉPONSES — ZONE CLOISONNÉE
//
// Règle 2 (non négociable) : ces deux modèles ne portent AUCUNE colonne,
// AUCUNE clé étrangère et AUCUN index vers Inscription ou Participant.
// Le seul chemin de jointure remonte vers Question → Section → Questionnaire
// → Seminaire, jamais vers l'identité du répondant.
// Pas de timestamp précis non plus : seul `jourSoumission` (DATE) existe,
// pour empêcher toute corrélation temporelle avec `inscription.aReponduLe`.
// ============================================================

model Soumission {
  id              String   @id @default(uuid())
  questionnaireId String   @map("questionnaire_id")
  jourSoumission  DateTime @default(dbgenerated("CURRENT_DATE")) @map("jour_soumission") @db.Date

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  reponses      Reponse[]

  @@index([questionnaireId])
  @@map("soumission")
}

// Règle d'affichage (non négociable) : toute liste de valeurTexte (réponses
// libres) doit être retournée dans un ordre aléatoire par la couche d'accès
// aux données, jamais dans l'ordre d'insertion / l'ordre des id — l'ordre
// physique des lignes trahit qui a répondu en premier, ce qui suffit à
// réidentifier quelqu'un dans un petit groupe. Ne jamais faire
// `ORDER BY id`/`createdAt` sur ces listages ; utiliser `ORDER BY random()`
// (ou un mélange équivalent côté application) — voir lib/anonymat.ts.
model Reponse {
  id              String  @id @default(uuid())
  soumissionId    String  @map("soumission_id")
  questionId      String  @map("question_id")
  valeurNumerique Float?  @map("valeur_numerique")
  valeurTexte     String? @map("valeur_texte")
  valeurOptions   Json?   @map("valeur_options")

  soumission Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([soumissionId])
  @@index([questionId])
  @@map("reponse")
}

// ============================================================
// MESSAGES ANONYMES
// ============================================================

enum StatutMessage {
  NOUVEAU
  LU
  TRAITE

  @@map("statut_message")
}

// Même règle d'affichage que pour Reponse.valeurTexte : la liste des messages
// visibles par l'organisateur (une fois le seuil atteint) est retournée dans
// un ordre aléatoire, jamais chronologique.
model MessageAnonyme {
  id                  String        @id @default(uuid())
  seminaireId         String        @map("seminaire_id")
  contenu             String
  jourEnvoi           DateTime      @default(dbgenerated("CURRENT_DATE")) @map("jour_envoi") @db.Date
  // permet à l'auteur de revenir lire une réponse sans se dévoiler
  codeSuiviHash       String        @map("code_suivi_hash")
  statut              StatutMessage @default(NOUVEAU)
  reponseOrganisateur String?       @map("reponse_organisateur")
  dateReponse         DateTime?     @map("date_reponse")

  seminaire Seminaire @relation(fields: [seminaireId], references: [id], onDelete: Cascade)

  @@index([seminaireId])
  @@map("message_anonyme")
}

// ============================================================
// RECUEIL — formulaire de recueil des besoins pré-formation
//
// Lot entièrement indépendant du questionnaire d'évaluation (Questionnaire/
// Section/Question/Soumission/Reponse ci-dessus) : deux tables, deux
// parcours, jamais de jointure entre les deux. L'évaluation est anonyme
// (Règle 2, zone cloisonnée) ; le recueil est nominatif par nature — chaque
// RecueilReponse porte directement nom/prénom, pas de détour par un
// Participant ni une Inscription. Pas de jeton personnel, pas de session :
// une soumission est un envoi anonyme-du-point-de-vue-technique (personne ne
// se réauthentifie jamais pour la relire), simplement identifiée par qui
// répond.
// ============================================================

enum TypeRecueilQuestion {
  TEXTE_LIBRE
  CHOIX_UNIQUE
  CHOIX_MULTIPLE

  @@map("type_recueil_question")
}

// Un seul recueil par séminaire (seminaireId unique) : contrairement au
// questionnaire d'évaluation, pas de notion de modèle réutilisable ni de
// verrouillage après réponse — l'organisateur prépare son recueil une fois,
// avant diffusion. `codeAcces` (lien participant, largement diffusé par
// WhatsApp/e-mail) et `codeConsultation` (lien formateur, donne accès aux
// réponses nominatives) sont deux nanoid indépendants : le second n'est
// JAMAIS dérivable du premier — voir genererCodeAccesRecueil/
// genererCodeConsultationRecueil (lib/jeton.ts), qui n'ont aucune relation
// mathématique entre eux au-delà d'utiliser tous deux nanoid.
model Recueil {
  id               String   @id @default(uuid())
  seminaireId      String   @unique @map("seminaire_id")
  cabinetId        String   @map("cabinet_id")
  titre            String
  // Texte d'objectif affiché en tête du formulaire participant.
  description      String
  codeAcces        String   @unique @map("code_acces")
  codeConsultation String   @unique @map("code_consultation")
  actif            Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  seminaire Seminaire         @relation(fields: [seminaireId], references: [id], onDelete: Restrict)
  cabinet   Cabinet           @relation(fields: [cabinetId], references: [id])
  questions RecueilQuestion[]
  reponses  RecueilReponse[]

  @@index([cabinetId])
  @@map("recueil")
}

model RecueilQuestion {
  id        String              @id @default(uuid())
  recueilId String              @map("recueil_id")
  intitule  String
  type      TypeRecueilQuestion
  // CHOIX_UNIQUE/CHOIX_MULTIPLE : { choix: [{ id, libelle }], avecAutre: bool }
  // — avecAutre n'a de sens que pour CHOIX_MULTIPLE (voir mockup organisateur).
  // TEXTE_LIBRE : null.
  options   Json?
  ordre     Int

  recueil Recueil @relation(fields: [recueilId], references: [id], onDelete: Cascade)

  @@index([recueilId])
  @@map("recueil_question")
}

// Pas de FK vers Participant ni Inscription (volontaire, voir note de section
// plus haut) : nom/prénom sont des colonnes propres à cette table, pas une
// référence. onDelete Restrict sur le recueil : une donnée nominative
// répondue ne doit jamais disparaître silencieusement.
model RecueilReponse {
  id           String   @id @default(uuid())
  recueilId    String   @map("recueil_id")
  nom          String
  prenom       String
  fonction     String?
  organisation String?
  // { [questionId]: string | string[] } — chaîne pour TEXTE_LIBRE/CHOIX_UNIQUE,
  // tableau de chaînes pour CHOIX_MULTIPLE (texte de "Autre" ajouté au tableau
  // s'il est coché et renseigné).
  reponses     Json
  createdAt    DateTime @default(now()) @map("created_at")

  recueil Recueil @relation(fields: [recueilId], references: [id], onDelete: Restrict)

  @@index([recueilId])
  @@map("recueil_reponse")
}
